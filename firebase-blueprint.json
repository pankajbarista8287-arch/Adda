        "roomId": { "type": "string" },
        "addaId": { "type": "string" },
        "familyId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderVip": { "type": "string" },
        "msgType": { "type": "string", "enum": ["CHAT", "GIFT", "SYSTEM"] },
