      "description": "ADDA Families."
    },
    "/families/{familyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/RoomMember" },
      "description": "Members of a family."
    },
    "/families/{familyId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Family chat messages."
    },
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/entities/Agency" },
