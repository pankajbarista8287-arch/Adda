        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "coins", "diamonds", "totalSpentCoins", "totalEarnedDiamonds", "totalRechargedInr", "createdAt", "updatedAt"]
    },
    "WalletTransaction": {
      "title": "WalletTransaction",
      "description": "Immutable gift, reward, and recharge transaction ledger.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverId": { "type": "string" },
        "receiverName": { "type": "string" },
        "type": { "type": "string", "enum": ["GIFT_SEND", "RECHARGE_CREDIT", "MISSION_REWARD", "VIP_PURCHASE", "ADMIN_ADJUST"] },
        "amountCoins": { "type": "integer" },
        "amountDiamonds": { "type": "integer" },
        "giftId": { "type": "string" },
        "giftName": { "type": "string" },
        "quantity": { "type": "integer" },
        "contextId": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "type", "amountCoins", "amountDiamonds", "quantity", "createdAt"]
    },
    "RechargeOrder": {
      "title": "RechargeOrder",
      "description": "Indian Rupee UPI/payment gateway recharge order awaiting verified backend confirmation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "packageId": { "type": "string" },
        "packageLabel": { "type": "string" },
        "amountInr": { "type": "integer" },
        "coinsAmount": { "type": "integer" },
        "paymentMethod": { "type": "string", "enum": ["UPI", "RAZORPAY", "GOOGLE_PLAY"] },
        "utrReference": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "VERIFIED", "REJECTED", "REFUNDED"] },
        "verifiedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "packageId", "amountInr", "coinsAmount", "paymentMethod", "utrReference", "status", "createdAt", "updatedAt"]
    },
    "GiftItem": {
      "title": "GiftItem",
      "description": "Admin-controlled animated gift item catalog.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "nameHi": { "type": "string" },
        "category": { "type": "string", "enum": ["LOVE", "COUPLE", "ROYAL", "LUXURY", "FESTIVAL", "PREMIUM", "VIP", "SPECIAL"] },
        "priceCoins": { "type": "integer" },
        "diamondValue": { "type": "integer" },
        "animationType": { "type": "string", "enum": ["FLOAT_2D", "ORBIT_3D", "FULLSCREEN_ROYAL"] },
        "iconKey": { "type": "string" },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "nameHi", "category", "priceCoins", "diamondValue", "animationType", "iconKey", "active", "updatedAt"]
    },
    "VoiceRoom": {
      "title": "VoiceRoom",
      "description": "Live multi-seat voice room.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "roomType": { "type": "string", "enum": ["PUBLIC", "PRIVATE", "PASSWORD"] },
        "roomPin": { "type": "string" },
        "seatCount": { "type": "integer" },
        "themeId": { "type": "string" },
        "announcement": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "onlineCount": { "type": "integer" },
        "totalGiftCoins": { "type": "integer" },
        "pkActive": { "type": "boolean" },
        "moderatorUids": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "ownerId", "ownerName", "roomType", "seatCount", "themeId", "level", "xp", "onlineCount", "totalGiftCoins", "pkActive", "moderatorUids", "active", "createdAt", "updatedAt"]
    },
    "RoomSeat": {
      "title": "RoomSeat",
      "description": "Microphone seat inside a voice room or ADDA group.",
