      "properties": {
        "roomId": { "type": "string" },
        "addaId": { "type": "string" },
        "familyId": { "type": "string" },
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "vipTier": { "type": "string" },
        "role": { "type": "string" },
        "muted": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "username", "role", "joinedAt"]
    },
    "AddaGroup": {
      "title": "AddaGroup",
      "description": "User-created ADDA community group with dedicated voice lounge and roles.",
