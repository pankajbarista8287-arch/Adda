        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "publicAdda": { "type": "boolean" },
        "themeId": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "memberCount": { "type": "integer" },
        "seatCount": { "type": "integer" },
        "coAdminUids": { "type": "array" },
        "moderatorUids": { "type": "array" },
        "mutedUids": { "type": "array" },
        "bannedUids": { "type": "array" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "ownerName", "publicAdda", "themeId", "level", "xp", "memberCount", "seatCount", "coAdminUids", "moderatorUids", "mutedUids", "bannedUids", "active", "createdAt", "updatedAt"]
    },
    "PkBattle": {
      "title": "PkBattle",
