      "description": "Special ADDA community groups."
    },
    "/adda_groups/{addaId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/RoomMember" },
      "description": "Members and roles in an ADDA group."
    },
    "/adda_groups/{addaId}/seats/{seatId}": {
      "schema": { "$ref": "#/entities/RoomSeat" },
      "description": "Live voice seats in an ADDA group."
    },
    "/adda_groups/{addaId}/messages/{msgId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Live chat and gift feed in an ADDA group."
    },
    "/pk_battles/{battleId}": {
      "schema": { "$ref": "#/entities/PkBattle" },
