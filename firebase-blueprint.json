        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "ownerName", "managerUids", "hostCount", "totalDiamonds", "commissionPercent", "createdAt", "updatedAt"]
    },
    "AgencyHost": {
      "title": "AgencyHost",
