  "firestore": {
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Server-verified administrator accounts."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user social profiles and game progression."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateAccount" },
      "description": "Owner-only PII and privacy settings."
    },
    "/users/{userId}/notifications/{notifId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notification inbox."
    },
    "/users/{userId}/missions/{missionId}": {
      "schema": { "$ref": "#/entities/UserMission" },
      "description": "User daily/weekly missions and reward claims."
    },
    "/wallets/{userId}": {
