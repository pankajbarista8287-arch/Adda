        "userId": { "type": "string" },
        "missionKey": { "type": "string" },
        "title": { "type": "string" },
        "progress": { "type": "integer" },
        "target": { "type": "integer" },
        "rewardCoins": { "type": "integer" },
        "rewardXp": { "type": "integer" },
        "completed": { "type": "boolean" },
        "claimed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "missionKey", "title", "progress", "target", "rewardCoins", "rewardXp", "completed", "claimed", "updatedAt"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "Server-validated user wallet for Coins and Diamonds.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "coins": { "type": "integer" },
        "diamonds": { "type": "integer" },
        "totalSpentCoins": { "type": "integer" },
        "totalEarnedDiamonds": { "type": "integer" },
        "totalRechargedInr": { "type": "integer" },
