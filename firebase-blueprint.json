      "properties": {
        "roomId": { "type": "string" },
        "addaId": { "type": "string" },
        "seatIndex": { "type": "integer" },
        "occupantId": { "type": "string" },
        "occupantName": { "type": "string" },
        "occupantVip": { "type": "string" },
        "muted": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "speaking": { "type": "boolean" },
        "speakingLevel": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
