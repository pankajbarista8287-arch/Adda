{
  "entities": {
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Authorized server-verified ADDA administrator account (AKKI_ADMIN).",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string" },
        "adminCode": { "type": "string", "enum": ["AKKI_ADMIN"] },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "MODERATOR"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminUid", "adminCode", "email", "role", "createdAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public social profile, levels, VIP tier, and community affiliation (no PII).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "addaCode": { "type": "string" },
        "username": { "type": "string" },
        "bio": { "type": "string" },
        "age": { "type": "integer" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER"] },
        "avatarUrl": { "type": "string" },
        "avatarPreset": { "type": "string" },
        "level": { "type": "integer" },
        "xp": { "type": "integer" },
        "giftSendLevel": { "type": "integer" },
        "giftReceiveLevel": { "type": "integer" },
        "vipTier": { "type": "string", "enum": ["NONE", "VIP", "SVIP"] },
        "frameStyle": { "type": "string" },
        "nameColorHex": { "type": "string" },
        "familyId": { "type": "string" },
        "agencyId": { "type": "string" },
        "hostStatus": { "type": "string", "enum": ["NONE", "PENDING", "APPROVED"] },
        "verified": { "type": "boolean" },
        "banned": { "type": "boolean" },
        "online": { "type": "boolean" },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "friendsCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "addaCode", "username", "level", "xp", "vipTier", "verified", "banned", "online", "createdAt", "updatedAt"]
    },
    "UserPrivateAccount": {
      "title": "UserPrivateAccount",
      "description": "Owner-only PII and security/language preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "preferredLang": { "type": "string", "enum": ["hi", "en"] },
        "securityPinSet": { "type": "boolean" },
        "twoFactorEnabled": { "type": "boolean" },
        "privacyDiscoverable": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "preferredLang", "updatedAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification entry for a user.",
      "type": "object",
