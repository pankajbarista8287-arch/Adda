        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "msgType", "text", "createdAt"]
    },
    "RoomMember": {
      "title": "RoomMember",
      "description": "Member entry inside a voice room, ADDA group, or family.",
